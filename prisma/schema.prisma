generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  NAKES
}

// Enum tambahan untuk jenis kelamin
enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  nakesProfile   NakesProfile?
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Data Profil Pasien
  namaLengkap  String
  tanggalLahir DateTime?
  jenisKelamin JenisKelamin?
  nomorTelepon String?
  alamat       String?
  kondisiMedis String?
  catatanAwal  String?

  // Relasi: Nakes yang bertanggung jawab
  nakesId String?
  nakes   NakesProfile? @relation(fields: [nakesId], references: [id])

  therapySessions TherapySession[]
}

model NakesProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Data Profil Nakes
  namaLengkap  String
  spesialisasi String?
  nomorRegis   String?
  faskes       String?
  nomorTelepon String?

  pasien PatientProfile[]
}

model TherapyMovement {
  id          String   @id @default(uuid())
  namaGerakan String
  deskripsi   String?
  instruksi   String   @db.Text
  mediaUrl    String?  // URL video atau gambar
  mediaType   String?  // "VIDEO" atau "IMAGE"
  
  prescriptions TherapyPrescription[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TherapyPrescription {
  id               String   @id @default(uuid())
  patientId        String
  nakesId          String
  
  movementId       String
  movement         TherapyMovement @relation(fields: [movementId], references: [id])

  targetRepetisi   Int
  frekuensiPerHari Int
  tanggalMulai     DateTime
  tanggalBerakhir  DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions TherapySession[]
}

model TherapySession {
  id                String   @id @default(uuid())
  patientId         String
  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId    String?
  prescription      TherapyPrescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  programName       String
  estimatedAngle    Float
  validRepetitions  Int
  durationMs        Int
  sampleCount       Int
  performedAt       DateTime
  createdAt         DateTime @default(now())

  @@index([patientId, performedAt])
}
