generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  PATIENT
  NAKES
}

// Enum tambahan untuk jenis kelamin
enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum TherapyType {
  GYROSCOPE
  CAMERA
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  nakesProfile   NakesProfile?
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  namaLengkap  String
  tanggalLahir DateTime?
  jenisKelamin JenisKelamin?
  nomorTelepon String?
  alamat       String?
  kondisiMedis String?
  riwayatPenyakit String? @db.Text
  alergi       String? @db.Text
  lokasiKeluhan String?
  tanggalMulaiKeluhan DateTime?
  skalaNyeri   Int?
  catatanAwal  String?

  therapySessions TherapySession[]
  nakesId String?
  nakes   NakesProfile? @relation(fields: [nakesId], references: [id])
  connectionCode String? @unique
  connectionCodeExpiresAt DateTime?

  medicationSchedules MedicationSchedule[]
  medicationLogs MedicationLog[]
  consultations  Consultation[]
}

model NakesProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  namaLengkap  String
  spesialisasi String?
  nomorRegis   String?
  faskes       String?
  nomorTelepon String?

  pasien PatientProfile[]
  medicationSchedules MedicationSchedule[]
  consultations  Consultation[]
}

model TherapyMovement {
  id            String   @id @default(uuid())
  namaGerakan   String
  deskripsi     String?
  instruksi     String   @db.Text
  mediaUrl      String?
  mediaType     String?
  imageData     Bytes?
  imageMimeType String?
  youtubeUrl    String?

  prescriptions TherapyPrescription[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TherapyPrescription {
  id               String   @id @default(uuid())
  patientId        String
  nakesId          String

  movementId       String
  movement         TherapyMovement @relation(fields: [movementId], references: [id])

  targetRepetisi   Int
  frekuensiPerHari Int
  tanggalMulai     DateTime
  tanggalBerakhir  DateTime

  therapySessions TherapySession[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TherapySession {
  id                String   @id @default(uuid())
  patientId         String
  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescriptionId    String?
  prescription      TherapyPrescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  programName       String
  therapyType       TherapyType @default(GYROSCOPE)
  estimatedAngle    Float
  validRepetitions  Int
  durationMs        Int
  sampleCount       Int
  performedAt       DateTime
  createdAt         DateTime @default(now())

  @@index([patientId, performedAt])
}

model MedicationSchedule {
  id             String   @id @default(uuid())
  patientId      String
  nakesId        String
  medicationName String
  dosage         String
  frequency      String   
  timeToTake     String[] 
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  patient        PatientProfile  @relation(fields: [patientId], references: [id])
  nakes          NakesProfile    @relation(fields: [nakesId], references: [id])
  logs           MedicationLog[]
}

model MedicationLog {
  id             String   @id @default(uuid())
  scheduleId     String
  patientId      String
  status         String   
  takenAt        DateTime @default(now())

  schedule       MedicationSchedule @relation(fields: [scheduleId], references: [id])
  patient        PatientProfile     @relation(fields: [patientId], references: [id])
}

model Consultation {
  id               String             @id @default(uuid())
  patientId        String
  nakesId          String
  subject          String
  description      String             @db.Text
  location         String?
  painScale        Int?
  symptomStartedAt DateTime?
  status           ConsultationStatus @default(PENDING)
  response         String?            @db.Text
  resolvedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  patient          PatientProfile     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  nakes            NakesProfile       @relation(fields: [nakesId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([nakesId, status])
}
