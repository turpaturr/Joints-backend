generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  PATIENT
  NAKES
}

// Enum tambahan untuk jenis kelamin
enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientProfile PatientProfile?
  nakesProfile   NakesProfile?
}

model PatientProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  namaLengkap  String
  tanggalLahir DateTime?
  jenisKelamin JenisKelamin?
  nomorTelepon String?
  alamat       String?
  kondisiMedis String?
  catatanAwal  String?

  nakesId String?
  nakes   NakesProfile? @relation(fields: [nakesId], references: [id])

  medicationSchedules MedicationSchedule[]
  medicationLogs MedicationLog[]
}

model NakesProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  namaLengkap  String
  spesialisasi String?
  nomorRegis   String?
  faskes       String?
  nomorTelepon String?

  pasien PatientProfile[]
  medicationSchedules MedicationSchedule[]
}

model TherapyMovement {
  id          String   @id @default(uuid())
  namaGerakan String
  deskripsi   String?
  instruksi   String   @db.Text
  mediaUrl    String?  // URL video atau gambar
  mediaType   String?  // "VIDEO" atau "IMAGE"
  
  prescriptions TherapyPrescription[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TherapyPrescription {
  id               String   @id @default(uuid())
  patientId        String
  nakesId          String
  
  movementId       String
  movement         TherapyMovement @relation(fields: [movementId], references: [id])

  targetRepetisi   Int
  frekuensiPerHari Int
  tanggalMulai     DateTime
  tanggalBerakhir  DateTime

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MedicationSchedule {
  id             String   @id @default(uuid())
  patientId      String
  nakesId        String
  medicationName String
  dosage         String
  frequency      String   
  timeToTake     String[] 
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  patient        PatientProfile  @relation(fields: [patientId], references: [id])
  nakes          NakesProfile    @relation(fields: [nakesId], references: [id])
  logs           MedicationLog[]
}

model MedicationLog {
  id             String   @id @default(uuid())
  scheduleId     String
  patientId      String
  status         String   
  takenAt        DateTime @default(now())

  schedule       MedicationSchedule @relation(fields: [scheduleId], references: [id])
  patient        PatientProfile     @relation(fields: [patientId], references: [id])
}